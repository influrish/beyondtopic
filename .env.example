# Copy to your process manager's environment configuration. Do not commit secrets.
BEYONDTOPIC_SECRET=replace-with-a-long-random-secret
BEYONDTOPIC_ADMIN=admin
# Optional. If omitted on first launch, a one-time password is printed in the terminal.
BEYONDTOPIC_PASSWORD=
BEYONDTOPIC_DB=./data/beyondtopic.sqlite3
BEYONDTOPIC_HOST=127.0.0.1
PORT=8000
BEYONDTOPIC_URL=http://localhost:8000
BEYONDTOPIC_TIMEZONE=Asia/Kolkata
